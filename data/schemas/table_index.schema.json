{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared Table Index",
  "type": "object",
  "required": ["schema_version", "tables"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table_id", "path", "image_path", "status"],
        "properties": {
          "table_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^catalog/tables/.+/table\\.json$"
          },
          "image_path": {
            "type": "string",
            "pattern": "^catalog/tables/.+/source.*\\.(png|jpg|jpeg)$"
          },
          "status": {
            "type": "string",
            "enum": ["active", "draft", "deprecated"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lookup Bindings Schema",
  "type": "object",
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_variable", "table_id", "output_key", "selectors"],
        "properties": {
          "target_variable": {
            "type": "string",
            "minLength": 1
          },
          "table_id": {
            "type": "string",
            "minLength": 1
          },
          "output_key": {
            "type": "string",
            "minLength": 1
          },
          "selectors": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "axis_input": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "trace_label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
